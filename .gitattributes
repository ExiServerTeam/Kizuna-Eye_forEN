# Normalize line endings in the repository.
# Go source is gofmt-sensitive: CRLF makes every line show as changed and
# breaks `gofmt -l` cleanliness, so force LF for Go and other text files.
* text=auto eol=lf

*.go   text eol=lf
*.mod  text eol=lf
*.sum  text eol=lf
*.sh   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Binary artifacts must never be modified.
*.so   binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.pdf  binary
