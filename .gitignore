dashboard_config.json
agent_config.json
modules.json
# users.json holds bcrypt password hashes; never commit it.
users.json
# sessions.json holds session hashes; never commit it.
sessions.json
sessions.json.*
# Uploaded avatar images are runtime data; never commit them.
avatars/
logs/
*.log
# Rotated logs (e.g. agent.log.1, kizuna-security.log.legacy-...).
# Plain "*.log" does NOT match these, so they were tracked by "git add -A".
*.log.*
*.so
*.meta.json
# プラグインのソースは追跡する。かつては plugins/ 全体を無視していたが、
# Kizuna-Security のソースを plugins/Kizuna-Security/ へ取り込んだため、
# ディレクトリ丸ごとの無視はやめ、ビルド成果物と鍵だけを除外する。
plugins/**/keys/
plugins/**/*.so
plugins/**/logs/
plugins/Kizuna-Security/plugin/kizuna-security-plugin
# Root-level build outputs only. A bare "dashboard" / "agent" /
# "plugin-inspect" pattern also matches cmd/dashboard/, cmd/agent/ and
# cmd/plugin-inspect/, which silently ignored real source files.
/agent_linux
/dashboard_linux
/plugin-inspect
/agent
/dashboard
# Compiled test binaries (e.g. from "go test -c").
/dashboard_test
/agent_test
*.test
*.tmp

# バックアップファイル
*.bak
*.bak-*

# SSH credentials for local scripts (never commit)
scripts/.ssh_env

# Output of scripts/scan_emoji.py (generated report, never commit)
emoji_report.txt

keys/
_pentest_backup_*/
*.prepatch-*
*.fimtest-bak
*.swp
*.swo
*~
scripts/patch_*.py
scripts/new_*.tpl
scripts/attack_*.py
scripts/ws_agent_attack.py
scripts/d_poc_plugin.go

