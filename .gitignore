dashboard_config.json
agent_config.json
modules.json
# users.json holds bcrypt password hashes; never commit it.
users.json
# sessions.json holds session hashes; never commit it.
sessions.json
sessions.json.*
# Uploaded avatar images are runtime data; never commit them.
avatars/
logs/
*.log
# Rotated logs (e.g. agent.log.1, kizuna-security.log.legacy-...).
# Plain "*.log" does NOT match these, so they were tracked by "git add -A".
*.log.*
*.so
# Plugin detached signatures are build artifacts (regenerated by plugin-sign).
*.so.sig
*.meta.json
# プラグインは本体リポジトリに同梱しない（別リポジトリ/別フォルダで管理）。
# ビルド成果物（*.so / *.so.sig）と鍵は上で除外済み。
# Root-level build outputs only. A bare "dashboard" / "agent" /
# "plugin-inspect" pattern also matches cmd/dashboard/, cmd/agent/ and
# cmd/plugin-inspect/, which silently ignored real source files.
/agent_linux
/dashboard_linux
/plugin-inspect
/agent
/dashboard
# Compiled test binaries (e.g. from "go test -c").
/dashboard_test
/agent_test
*.test
*.tmp

# バックアップファイル
*.bak
*.bak-*

# SSH credentials for local scripts (never commit)
scripts/.ssh_env

# Output of scripts/scan_emoji.py (generated report, never commit)
emoji_report.txt

keys/
_pentest_backup_*/
*.prepatch-*
*.fimtest-bak
*.swp
*.swo
*~
scripts/patch_*.py
scripts/new_*.tpl
scripts/attack_*.py
scripts/ws_agent_attack.py
scripts/d_poc_plugin.go

# ---- merged 2026-10-04: restore broader secret/build/os patterns ----
# secrets
*.key
*.pem
.env
.env.*
*_config.json
!*_config.example.json
# logs / runtime data
*.jsonl
tmp/
# build artifacts
*.exe
*.dll
*.dylib
kizuna-dashboard
# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
# deps / archives
node_modules/
vendor/
# Go workspace files are developer-local. The plugin module carries its own
# `replace Kizuna-Eye => ../../..`, so both modules build without a workspace
# (install.sh/update.sh build the plugin with GOWORK=off), and CI must not
# suddenly start evaluating the plugin module through a committed go.work.
go.work
go.work.sum
*.tar.gz
*.zip
# stray editor temp name (Windows 8.3 artifact)
NDH6SA~M

# Debian package build output (generated by packaging/build-deb.sh)
dist/

# APT repository output and its signing key (generated; never commit the key)
apt-repo/
.gnupg-apt/

# 手元資料（リポジトリ外のドキュメント・個人メモ。追跡しない）
# Local reference materials (out-of-repo docs / personal notes; never tracked).
Kizunaシリーズ　資料/

# エディタ/手動バックアップの残骸
# Stray editor / manual backup artifacts.
install.sh.bak*

# curl クッキージャー（手動/ペネトレ検証の残骸。セッショントークンを含む）
# curl cookie jars (manual / pentest leftovers; contain a session token).
# ルート直下のみマッチ（ルール: .gitignore の先頭に / を付ける）。
# Root-level only (rule: prefix patterns with "/" to avoid over-matching subdirs).
/cookies.txt
/a[0-9].txt
/b[0-9].txt
