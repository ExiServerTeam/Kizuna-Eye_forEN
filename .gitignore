*.jsonl
tmp/
# build artifacts
*.exe
*.dll
*.dylib
kizuna-dashboard
# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
# deps / archives
node_modules/
vendor/
*.tar.gz
*.zip
