# ============================================================
# Kizuna-Eye Dashboard systemd unit
#
# dashboard を「1プロセス = 1サービス」で直接管理する。
# 既存の kizuna-eye.service (Type=oneshot + start.sh/stop.sh) は
# start.sh が背景プロセスを起動して戻るため、子プロセスが SIGSEGV で
# 落ちても systemd は「active」のままで再起動できない。
# この unit は Type=simple で本体を直接 exec するので
#   - クラッシュ (SIGSEGV/SIGABRT) = 失敗 → Restart=on-failure が発火
#   - LimitCORE=infinity でコアダンプを取得
#   - GOTRACEBACK=crash で各 goroutine のスタックを残す
# が機能する。
#
# インストール（install.sh が __...__ を置換して導入する）:
#   sudo ./install.sh
# 手動で入れる場合:
#   sed -e "s|__USER__|$USER|g" -e "s|__DIR__|$PWD|g" \
#       -e "s|__BIN__|/opt/kizuna-eye/bin|g" \
#       -e "s|__DATA__|$HOME/.kizuna-eye/data|g" \
#       systemd/kizuna-dashboard.service \
#       | sudo tee /etc/systemd/system/kizuna-dashboard.service >/dev/null
#   sudo systemctl daemon-reload && sudo systemctl enable --now kizuna-dashboard
# ============================================================
[Unit]
Description=Kizuna-Eye Dashboard
Documentation=file://__DIR__/docs/PROCEDURE.md
After=network-online.target
Wants=network-online.target

# 再起動の暴走（設定ミスで即死を繰り返す）を防ぐ。StartLimit* は [Unit] の
# 設定。ここに置かないと systemd が「Unknown key ... ignoring」で無視し、
# 制限が効かない（agent unit と同じ理由）。
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=__USER__
Group=__USER__
# H-1 移行後、agent が書くログ/状態はグループ kizuna-eye 所有になる。
# systemd は User= の補助グループを自動では引き継がないため、明示的に
# SupplementaryGroups を与えて dashboard が共有ログを読めるようにする。
# グループが無い環境（H-1 未実施）では systemd が警告するだけで起動は続く。
SupplementaryGroups=kizuna-eye
WorkingDirectory=__DIR__

# Go ランタイムのメモリ調整（start.sh と同じ既定）。
Environment=GOGC=50
Environment=GOMEMLIMIT=64MiB
# SIGSEGV/SIGABRT 時に全 goroutine のスタックを出力する。
Environment=GOTRACEBACK=crash
Environment=GODEBUG=madvdontneed=1

# コアダンプを確実に残す（kernel.core_pattern が apport のままでも
# systemd 経由なら systemd-coredump が拾う。詳細は systemd/setup-coredump.sh）。
LimitCORE=infinity

# Dashboard は設定 (dashboard_config.json) を --config で受け取る。
# 設定内の相対パスは設定ファイルのディレクトリ基準で解決される。
# ログ (logs/dashboard.log) は WorkingDirectory 基準になる。
ExecStart=__BIN__/dashboard_linux -config __DATA__/dashboard_config.json

# ---- 権限分離（dashboard 向けの保護）----
# dashboard は Web を公開し、アップロードされた .so を扱うため、侵害時の被害を
# 抑える保護を付ける。
#
# ワンクリック対処は特権サービス (kizuna-action.service, systemd socket
# activation) に委譲した。dashboard は /run/kizuna-eye/action.sock に接続して
# 結果を受け取るだけで root を要求しないため、以前 sudo の都合で外していた
# NoNewPrivileges / ProtectSystem / PrivateTmp も含め、全保護を適用できる。
#
# 注意: プラグインのアップロード先 (dashboard_config.json の plugins_dir、
# 既定 /opt/kizuna-eye/bin/plugins) は書き込み可能でなければならない。
# deb の postinst は ReadWritePaths を /var/lib/kizuna-eye だけに絞るため、
# 既定の plugins_dir を使うパッケージでは下の追記が必要（build-deb.sh が
# 既定 plugins_dir を検出して追記する）。
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectControlGroups=yes
PrivateTmp=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
# 設定・ログ・セッション・アップロード済みプラグイン・アクションソケットの
# 親ディレクトリのみ書き込みを許可する。
ReadWritePaths=/var/lib/kizuna-eye -__BIN__/plugins /run/kizuna-eye

# クラッシュ時のみ自動再起動（正常終了や手動 stop では再起動しない）。
Restart=on-failure
RestartSec=5

# 停止は SIGTERM を送って待つ。
KillSignal=SIGTERM
TimeoutStopSec=30

# journal に出す（アプリ自身のログファイルとは別に、クラッシュ痕跡を残す）。
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kizuna-dashboard

[Install]
WantedBy=multi-user.target
