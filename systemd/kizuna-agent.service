# ============================================================
# Kizuna-Eye Agent systemd unit (A-1: supervisor 化 + コアダンプ)
#
# 目的:
#   - 反復する SIGSEGV で agent が落ちても 5 秒後に自動復帰させ、
#     監視断（FIM/SSH/ポート/SUID/cron が静かに止まる）を最小化する。
#   - 落ちた瞬間のスタックとコアを残し、原因究明を可能にする。
#
# この unit は `user` で動かす暫定版。A-4（専用ユーザー kizuna-agent 化）は
#   systemd/kizuna-agent-a4.service + systemd/migrate-agent-user.sh
# を使う（AmbientCapabilities で /etc/shadow も読めるようになる）。
#
# インストール（推奨）:
#   sudo systemd/install-services.sh user
# ============================================================
[Unit]
Description=Kizuna-Eye Agent
Documentation=file://__DIR__/docs/PROCEDURE.md
After=network-online.target
Wants=network-online.target
# ダッシュボードより先に起こす必要は無い（agent 側が再接続する）。

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__DIR__

# Go ランタイムのメモリ調整（start.sh と同じ既定）。
Environment=GOGC=50
Environment=GOMEMLIMIT=64MiB
# SIGSEGV/SIGABRT 時に全 goroutine のスタックを出力する。
Environment=GOTRACEBACK=crash

# コアダンプを確実に残す。
LimitCORE=infinity

# agent は -config と -modules の 2 つを取る。
# 秘密 (chain.key / *_config.json / modules.json) は共有外の __DATA__ にある。
ExecStart=__BIN__/agent_linux -config __DATA__/agent_config.json -modules __DATA__/modules.json

# クラッシュ時のみ自動再起動（正常終了や手動 stop では再起動しない）。
Restart=on-failure
RestartSec=5
# 再起動の暴走を防ぐ（5 分間に 10 回失敗したら諦めて failed にする）。
StartLimitIntervalSec=300
StartLimitBurst=10

KillSignal=SIGTERM
# agent はバックアッププラグイン実行中でも中途半端なアーカイブを残さないよう待つ。
TimeoutStopSec=60

StandardOutput=journal
StandardError=journal
SyslogIdentifier=kizuna-agent

[Install]
WantedBy=multi-user.target
