# ============================================================
# Kizuna-Eye Agent systemd unit (H-1/A-4: 専用ユーザー kizuna-eye + 権限分離)
#
# 注: 既存の kizuna-eye.service は「start.sh を呼ぶ旧 system service」で別物。
#     本 unit は agent 単体を専用ユーザー kizuna-eye で動かす（名前衝突回避の
#     ため kizuna-eye-agent.service とする）。
#
# A-4 の目的:
#   - agent を運用アカウント `user` から切り離し、uid=1000 が奪われても
#     FIM ベースライン / チェーン鍵 / アラート状態を改変できないようにする。
#   - AmbientCapabilities=CAP_DAC_READ_SEARCH により /etc/shadow 等を
#     読めるようにし、A-2 の「権限不足 INFO」も解消する（agent 全体は非 root）。
#   - この capability により、cron 監視 (cronmon.go) は sudo ヘルパーを使わず
#     /var/spool/cron/crontabs を直接読める（NoNewPrivileges=yes と両立）。
#   - CAP_SYS_RAWIO は S.M.A.R.T の ATA パススルー (SG_IO) に必要。
#     実機で確認: CAP_DAC_READ_SEARCH だけでは `smartctl -H /dev/sda` が
#     「Read Device Identity failed: Operation not permitted」で失敗し、
#     ディスク健康状態・温度・書込量・通電時間（設計書 4.2 / 4.3）が
#     無言で欠落していた。CAP_SYS_RAWIO を併せて付与すると PASSED が読める。
#   - CAP_NET_ADMIN は Kizuna-Security の自動 IP ブロック (block_mode=enforce)
#     に必要。この unit は NoNewPrivileges=yes なので sudo は必ず失敗する
#     （"The no new privileges flag is set" を実測で確認）。sudo 依存のままだと
#     enforce を有効にしても攻撃時に初めてブロックが失敗していた。
#     blocker は firewall バイナリを直接実行する経路を先に試し、実測で
#     kizuna-eye が `nft add` に成功することを確認済み。
#
# 前提（systemd/migrate-agent-user.sh が作る）:
#   - ユーザー kizuna-eye (system/nologin, home /var/lib/kizuna-eye)
#   - /var/lib/kizuna-eye/{state,keys,logs} (state/keys は 0700, kizuna-eye 所有)
#   - 共有グループ kizuna-eye (kizuna-eye + 運用ユーザー) に所属
#   - 設定 (agent_config.json / modules.json) は __DATA__ のまま 0640 で共有する。
#     状態ファイルの絶対パスは modules.json 側に書き込まれている。
#
# インストール（推奨・install.sh から自動実行される）:
#   sudo ./install.sh --systemd
# 手動で行う場合:
#   sudo systemd/migrate-agent-user.sh <実行ユーザー>
# ============================================================
[Unit]
Description=Kizuna-Eye Agent (isolated user)
Documentation=file://__DIR__/docs/PROCEDURE.md
After=network-online.target
Wants=network-online.target

# 再起動の暴走を防ぐ（5 分間に 10 回失敗したら failed にする）。
# StartLimit* は [Unit] の設定。ここに置かないと systemd が「Unknown key ...
# ignoring」で無視し、制限が効かない。
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=kizuna-eye
Group=kizuna-eye
WorkingDirectory=__DIR__

Environment=GOGC=50
Environment=GOMEMLIMIT=64MiB
Environment=GOTRACEBACK=crash
# madvdontneed=1 makes the Go runtime return freed heap pages to the OS
# promptly (MADV_DONTNEED) instead of keeping them resident. Measured effect
# on the A4-4020 is small (~160KB on the dashboard) because most of the RSS
# is executable code pages, but it costs nothing and helps on a low-memory
# host when the heap spikes and then drops.
Environment=GODEBUG=madvdontneed=1

LimitCORE=infinity

# 新規ファイルは 0640 (group read) を既定にする。書き込み権は変えず、
# 運用ユーザー/ダッシュボードが agent の書くログを読めるようにするため。
UMask=0027

# 設定は __DATA__ の共有ファイルをそのまま読む。
ExecStart=__BIN__/agent_linux -config __DATA__/agent_config.json -modules __DATA__/modules.json

# ---- 権限分離 ----
# /etc/shadow 等を読みつつ、agent プロセス自体は非 root のまま。
# CAP_DAC_READ_SEARCH: DAC を迂回した読み取り（/etc/shadow, crontabs）。
# CAP_SYS_RAWIO      : S.M.A.R.T の ATA パススルー（smartctl の SG_IO）。
# CAP_NET_ADMIN      : 自動 IP ブロック（nft / iptables / firewalld の操作）。
# いずれも最小限で、汎用の root 権限は与えない。
AmbientCapabilities=CAP_DAC_READ_SEARCH CAP_SYS_RAWIO CAP_NET_ADMIN
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_RAWIO CAP_NET_ADMIN
NoNewPrivileges=yes
# ファイルシステムを読み取り専用化。書き込めるのは下の ReadWritePaths のみ。
ProtectSystem=strict
ProtectHome=read-only
# PrivateTmp=yes は agent 専用の隔離 /tmp を与えるが、その副作用で
# 共有の /tmp を対象とする SUID / FIM 監視が原理的に無効化される
# （agent が見る /tmp は systemd-private-.../tmp で、攻撃者が置く実
# /tmp のファイルが見えない）。攻撃検知を優先し PrivateTmp は無効にする。
# 書き込みは ProtectSystem=strict + ReadWritePaths で制限されるため、
# 実 /tmp を見えても書き込み権限は増えない（読み取り・inotify のみ）。
PrivateTmp=no
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
# ReadWritePaths: /var/lib/kizuna-eye は移行後の状態・鍵、__DIR__/logs は
# 未移行時のログ用。__DIR__ は install.sh / migrate-agent-user.sh / postinst.sh が
# 実パスへ置換する。先頭の "-" は「パスが無くても起動を失敗させない」指定。
# バックアップ等のプラグインが別の場所へ書き込む場合は、そのパスをここに追記する。
ReadWritePaths=/var/lib/kizuna-eye -__DIR__/logs

Restart=on-failure
RestartSec=5

KillSignal=SIGTERM
TimeoutStopSec=60

StandardOutput=journal
StandardError=journal
SyslogIdentifier=kizuna-eye-agent

[Install]
WantedBy=multi-user.target
