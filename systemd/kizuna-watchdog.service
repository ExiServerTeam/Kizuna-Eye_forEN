# ============================================================
# Kizuna-Eye 暫定 watch dog (user unit / sudo 不要)
# インストール:
#   install -d -m 700 ~/.config/systemd/user
#   sed "s|__DIR__|$PWD|g" systemd/kizuna-watchdog.service \
#     > ~/.config/systemd/user/kizuna-watchdog.service
#   cp -p systemd/kizuna-watchdog.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now kizuna-watchdog.timer
# ============================================================
[Unit]
Description=Kizuna-Eye watchdog (no-sudo interim)

[Service]
Type=oneshot
WorkingDirectory=__DIR__
# start.sh は nohup で agent/dashboard を「デタッチ」して起動するが、systemd の
# 既定 KillMode=control-group は oneshot service の終了時に cgroup 内の全プロセス
# (nohup した agent を含む) へ SIGTERM を送る。これが「起動2秒後に
# シャットダウンシグナル受信」の原因だった。KillMode=none で systemd に
# これらのプロセスを殺させない（従来の手動運用と同じ挙動に戻す）。
# 補足: KillMode=none は systemd で非推奨（将来削除予定）。削除された環境では
# KillMode=process（主プロセスのみが対象）へ置き換えると、nohup でデタッチした
# agent/dashboard を巻き込まずに済む。
KillMode=none
ExecStart=__DIR__/systemd/kizuna-watchdog.sh
